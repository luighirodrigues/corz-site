# Banco de dados (Postgres 14+)
DATABASE_URL="postgresql://usuario:senha@host:5432/corz?schema=public&sslmode=require"

# Segredo de assinatura das sessões — gere com: openssl rand -base64 48
SESSAO_SEGREDO=""

# Chave de cifra dos segredos TOTP (exatamente 32 bytes) — openssl rand -base64 32
CIFRA_SEGREDO=""

# Token do endpoint de publicação agendada (/api/cron/publicar)
CRON_SEGREDO=""

# URL pública canônica, sem barra final
NEXT_PUBLIC_SITE_URL="https://corz.com.br"

# ---- Aviso por e-mail dos formulários (opcional) -----------
# Sem estas variáveis o site grava o formulário e apenas não envia aviso.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USUARIO=""
SMTP_SENHA=""
SMTP_DE="CORZ Site <nao-responda@corz.com.br>"
EMAIL_DESTINO="contato@corz.com.br"
EMAIL_LEADS=""
EMAIL_CHAMADOS=""

# ---- Medição (opcional, embutida na compilação) ------------
NEXT_PUBLIC_GA4_ID=""
NEXT_PUBLIC_GTM_ID=""
NEXT_PUBLIC_META_PIXEL_ID=""
NEXT_PUBLIC_GOOGLE_ADS_ID=""
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=""
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
