# ============================================================
# Configuração de produção do site CORZ
#
# Copie para .env no servidor e preencha. Este arquivo NUNCA vai para o
# git — confira que .env está no .gitignore antes de qualquer commit.
#
# Gere cada segredo com um comando próprio. Reaproveitar o mesmo valor
# em dois campos anula o propósito de terem sido separados:
#
#   openssl rand -base64 48
# ============================================================

# ---- Domínio -----------------------------------------------
# ATENÇÃO: NEXT_PUBLIC_SITE_URL é embutida durante a COMPILAÇÃO, não
# lida em execução. Trocar aqui sem recompilar não tem efeito.
#
# O site só se deixa indexar quando esta URL contém "corz.com.br". Em
# qualquer outro endereço ele entra em modo homologação: noindex, robots
# negando tudo e sitemap vazio. O build avisa em qual modo compilou.
#
# Homologação:
#   DOMINIO=sitecorz.agenciafleck.com.br
#   NEXT_PUBLIC_SITE_URL=https://sitecorz.agenciafleck.com.br
#
# Produção:
DOMINIO=corz.com.br
NEXT_PUBLIC_SITE_URL=https://corz.com.br

# E-mail para os avisos do Let's Encrypt (vencimento, problemas de emissão).
EMAIL_TLS=ti@corz.com.br

# ---- Banco de dados ----------------------------------------
POSTGRES_USER=corz
POSTGRES_DB=corz
# openssl rand -base64 32

POSTGRES_PASSWORD=

# ---- Segredos da aplicação ---------------------------------
# Assinatura das sessões do painel — openssl rand -base64 48
SESSAO_SEGREDO=

# Cifra dos segredos de 2FA — openssl rand -base64 32
# ATENÇÃO: trocar este valor depois de alguém ativar o 2FA invalida os
# segredos já gravados, e todo mundo precisa reconfigurar o aplicativo
# autenticador. Guarde-o junto com as senhas do servidor.
CIFRA_SEGREDO=

# Protege o endpoint de publicação agendada — openssl rand -base64 32
CRON_SEGREDO=

# ---- Aviso por e-mail dos formulários ----------------------
# Cada formulário enviado no site vira um e-mail. O banco continua sendo
# a fonte da verdade; o e-mail é o aviso, para ninguém depender de
# lembrar de abrir o painel.
#
# Sem estas variáveis o site funciona normalmente e apenas não envia —
# registra um aviso no log. Nenhum formulário deixa de ser gravado por
# causa de SMTP fora do ar.
#
# O remetente PRECISA ser um endereço do próprio domínio. Usar um Gmail
# ou o e-mail de quem recebe faz SPF e DMARC reprovarem a mensagem, e
# ela cai em spam ou é recusada na entrada.
SMTP_HOST=smtp.seuprovedor.com.br
SMTP_PORT=587
SMTP_USUARIO=nao-responda@corz.com.br
SMTP_SENHA=
SMTP_DE=CORZ Site <nao-responda@corz.com.br>

# Destino dos avisos. Aceita vários endereços separados por vírgula.
# EMAIL_DESTINO é o padrão; os dois abaixo têm precedência quando
# preenchidos, e existem porque chamado de operação parada e pedido de
# diagnóstico raramente devem cair na mesma caixa.
EMAIL_DESTINO=contato@corz.com.br
EMAIL_LEADS=comercial@corz.com.br
EMAIL_CHAMADOS=suporte@corz.com.br

# ---- Medição -----------------------------------------------
# Tudo opcional e embutido na COMPILAÇÃO (são NEXT_PUBLIC_). Preencher
# depois exige recompilar. Sem valor, a tag correspondente nem existe no
# HTML: nenhuma requisição sai para o domínio do terceiro.
#
# Nada disso carrega antes de a pessoa aceitar na faixa de cookies. É a
# diferença entre cumprir a LGPD e apenas exibir um aviso.
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GOOGLE_ADS_ID=
NEXT_PUBLIC_LINKEDIN_PARTNER_ID=

# Verificação do Search Console por meta tag. Se você verificar por
# registro DNS — o método preferível —, deixe em branco.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
